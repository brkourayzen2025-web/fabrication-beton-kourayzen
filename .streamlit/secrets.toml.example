# Copie ce fichier en `secrets.toml` (sans .example) et remplace les valeurs.
# ⚠️ Ne JAMAIS committer secrets.toml sur GitHub (mets-le dans .gitignore).

# ==================================================================
# BASE DE DONNÉES POSTGRESQL (Supabase)
# ==================================================================
[postgres]
# URL de connexion Supabase
# Récupère-la sur : https://supabase.com/dashboard/project/_/settings/database
# Format : postgresql://user:password@host:port/postgres
url = "postgresql://postgres.abcdefgh:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"


# ==================================================================
# UTILISATEURS DE L'APPLICATION
# ==================================================================
# Deux rôles disponibles :
#   - "admin"    : accès total (formules, matériaux, engins, journal, tout)
#   - "pointeur" : préparation mélanges + productions + stock (entrée/ajustement)
#                  PAS de modification des formules/matériaux/engins/journal
#
# Change ces mots de passe AVANT le déploiement !

[users.radouane]
password = "CHANGE_MOI_MOT_DE_PASSE_ADMIN"
role = "admin"

[users.pointeur]
password = "CHANGE_MOI_MOT_DE_PASSE_POINTEUR"
role = "pointeur"

# Pour ajouter un autre utilisateur, copie le bloc et change :
#   [users.NOM_UTILISATEUR]
#   password = "SON_MOT_DE_PASSE"
#   role = "admin"       # ou "pointeur"
